rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // All application data access goes through the Next.js server, which
    // authenticates with the Firebase Admin SDK (service account). Admin SDK
    // calls BYPASS these rules entirely, so server-side verification is immune
    // to client tampering.

    // Helper: check if request has a valid Firebase Auth token.
    function isAuthed() {
      return request.auth != null;
    }

    // 1. Users Collection (server write-only; read requires auth)
    match /users/{userId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // 2. Withdrawals Collection (server write-only; read requires auth)
    match /withdrawals/{withdrawalId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // 3. Deposits Collection (server write-only; read requires auth)
    match /deposits/{depositId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // 4. Transactions Collection (audit ledger; server write-only; read requires auth)
    match /transactions/{txId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // 5. Used-hash ledger (server write-only; read requires auth)
    match /used_hashes/{hashId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // 6. Referral codes (server write-only; read requires auth)
    match /referral_codes/{codeId} {
      allow read: if isAuthed();
      allow write: if false;
    }

    // 7. Everything else: deny all client access.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
